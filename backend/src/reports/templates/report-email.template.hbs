<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{reportTitle}} | DataNexus</title>
  </head>
  <body style="margin:0;padding:28px 12px;background:#f3f6fb;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:620px;margin:0 auto;background:#ffffff;border:1px solid #e1e7ef;border-radius:14px;overflow:hidden;">
      <tr>
        <td style="padding:22px 30px;background:#173f68;color:#ffffff;">
          <p style="margin:0 0 6px;font-size:11px;letter-spacing:.14em;">DATANEXUS</p>
          <p style="margin:0;font-size:13px;color:#d9e7f5;">Reporte ejecutivo</p>
        </td>
      </tr>
      <tr>
        <td style="padding:30px;">
          <h1 style="margin:0 0 14px;font-size:23px;line-height:1.3;color:#173f68;">{{reportTitle}}</h1>
          <p style="margin:0 0 24px;line-height:1.6;white-space:pre-line;">{{customMessage}}</p>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 24px;background:#f7f9fc;border:1px solid #e6ebf2;border-radius:10px;">
            <tr><td style="padding:16px 18px 4px;font-size:12px;color:#64748b;">ARCHIVO</td></tr>
            <tr><td style="padding:0 18px 14px;font-size:14px;font-weight:600;">{{filename}}</td></tr>
            <tr><td style="padding:0 18px 16px;font-size:13px;color:#64748b;">{{fileSizeLabel}} · Generado {{generatedAt}}</td></tr>
          </table>
          <p style="margin:0 0 22px;">
            <a href="{{downloadUrl}}" style="display:inline-block;padding:13px 20px;background:#1f5f96;color:#ffffff;text-decoration:none;border-radius:8px;font-size:14px;font-weight:600;">Descargar reporte</a>
          </p>
          <p style="margin:0;font-size:12px;line-height:1.6;color:#64748b;">Este enlace seguro vence el {{expiresAt}}. Si el botón no abre, copia este enlace en tu navegador:<br><a href="{{downloadUrl}}" style="color:#1f5f96;word-break:break-all;">{{downloadUrl}}</a></p>
        </td>
      </tr>
      <tr>
        <td style="padding:16px 30px;border-top:1px solid #e6ebf2;font-size:11px;color:#94a3b8;">Generado automáticamente por DataNexus Platform.</td>
      </tr>
    </table>
  </body>
</html>
