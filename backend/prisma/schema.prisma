// Esquema de persistencia interna de DataNexus (Dossier Técnico, sección 4).
// Motor: PostgreSQL en todos los entornos (local vía docker-compose, staging y producción).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Matriz RBAC de 4 roles. Debe coincidir con USER_ROLES en src/auth/interfaces/user-role.ts.
enum Role {
  ADMIN
  OPERADOR
  LECTOR
  AUDITOR
}

/// Motores de bases de datos externas soportados. Debe coincidir con TIPOS_MOTOR en src/common/tipo-motor.ts.
enum TipoMotor {
  POSTGRESQL
  MYSQL
  SQLSERVER
  FIRESTORE
  MONGODB
}

/// Eventos de la bitácora. Debe coincidir con AUDIT_EVENT_TYPES en src/audit/audit.types.ts.
enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  USER_ROLE_CHANGED
  USER_INVITED
  CONNECTION_CREATED
  CONNECTION_UPDATED
  CONNECTION_DELETED
  REPORT_GENERATED_AND_SENT
  EXECUTE_JOIN
  EXPORT
  MODIFY_RECORD
  AUDIT_LOG_EXPORTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  LOGOUT
  SESSION_EXPIRED
  REFRESH_TOKEN_REUSED
  ACCOUNT_LOCKED
  WORKSPACE_UPDATED
  INVITATION_RESENT
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  USER_REMOVED
  BROWSE_DATA
  SAVED_QUERY_CREATED
  SAVED_QUERY_UPDATED
  SAVED_QUERY_DELETED
  SCHEDULED_REPORT_CREATED
  SCHEDULED_REPORT_UPDATED
  SCHEDULED_REPORT_DELETED
  SCHEDULED_REPORT_RUN
  ACCOUNT_CREATED
  PROFILE_UPDATED
  PASSWORD_CHANGED
  SESSIONS_REVOKED
  PAT_CREATED
  PAT_ROTATED
  PAT_REVOKED
  PAT_USED
  EXCEL_UPLOADED
  EXCEL_REPLACED
  EXCEL_DELETED
}

/// Estado persistido de una invitación. La expiración se calcula con expiresAt (PENDIENTE vencida = EXPIRADA).
/// Tipo de cuenta del workspace: personal (una persona) u organización (equipo con miembros e invitaciones).
enum TipoCuenta {
  PERSONAL
  ORGANIZACION
}

enum InvitationStatus {
  PENDIENTE
  ACEPTADA
  REVOCADA
}

/// Espacio de trabajo (tenant). Toda consulta de negocio se filtra por su id (RF-05).
model Workspace {
  id                    String           @id @default(uuid())
  nombreEmpresa         String
  /// Personal u organización. Los workspaces creados antes de este campo son organizaciones.
  tipoCuenta            TipoCuenta       @default(ORGANIZACION)
  /// Descripción breve que se muestra en la pantalla de Workspaces.
  descripcion           String?
  /// URL https del logo que muestra el cliente web.
  logoUrl               String?
  /// Zona horaria IANA (p. ej. America/Managua) para fechas y reportes programados.
  zonaHoraria           String           @default("UTC")
  /// Dominios de correo admitidos al invitar miembros. Vacío = sin restricción adicional.
  dominiosPermitidos    String[]         @default([])
  /// Campos sensibles por defecto del workspace; los consumirá el enmascaramiento configurable (RF-20).
  camposSensibles       String[]         @default([])
  fechaCreacion         DateTime         @default(now())
  fechaActualizacion    DateTime         @default(now()) @updatedAt
  users                 User[]
  conexiones            ConexionDB[]
  camposSensiblesReglas SensitiveField[]
  invitations           Invitation[]
  consultasGuardadas    SavedQuery[]
  reportesProgramados   ScheduledReport[]
  ejecucionesReportes            ReportExecution[]
  usoDiario                      WorkspaceUsageDaily[]
  tokensAcceso                   PersonalAccessToken[]
  archivosExcel                  ArchivoExcel[]
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String
  password            String
  role                Role                 @default(LECTOR)
  /// Intentos de login fallidos consecutivos. Se reinicia al entrar o al bloquear la cuenta.
  failedLoginAttempts Int                  @default(0)
  /// Bloqueo temporal tras LOGIN_MAX_ATTEMPTS intentos fallidos (RF-01/RF-02).
  lockedUntil         DateTime?
  workspaceId         String
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]
  sessions            UserSession[]
  invitationsSent     Invitation[]
  consultasGuardadas  SavedQuery[]
  versionesConsultas  SavedQueryVersion[]
  programacionesCreadas ScheduledReport[]
  tokensAcceso        PersonalAccessToken[]

  @@index([workspaceId])
}

model ConexionDB {
  id                         String    @id @default(uuid())
  nombre                     String?
  tipoMotor                  TipoMotor
  host                       String
  dbName                     String
  /// Credenciales cifradas (AES-256). Versión 1: cadena de conexión libre (legado). Versión 2: JSON estructurado por motor (RF-08/RF-09).
  connectionStringEncriptada String
  credencialesVersion        Int       @default(1)
  /// Metadatos NO secretos de las credenciales (puerto, usuario, ssl, projectId...). Nunca contiene contraseñas ni claves.
  detalles                   Json?
  /// Último health check (issue #40): HEALTHY, UNAVAILABLE o UNSUPPORTED. Lo actualizan la comprobación del
  /// dashboard y "Probar conexión", así el resumen no tiene que abrir conexiones en cada consulta.
  ultimoHealthStatus         String?
  ultimaLatenciaMs           Int?
  ultimoHealthAt             DateTime?
  workspaceId                String
  workspace                  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Bitácora inmutable: un trigger de PostgreSQL y PrismaService bloquean UPDATE, DELETE y TRUNCATE.
model RegistroAuditoria {
  id          String         @id @default(uuid())
  eventType   AuditEventType
  outcome     String
  actorUserId String?
  actorEmail  String?
  workspaceId String?
  targetType  String?
  targetId    String?
  detailsJson String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
}

/// Token de un solo uso para recuperar la contraseña (RF-03). Solo se guarda el hash SHA-256 del token.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Sesión de usuario (RF-04). El access token JWT lleva su id (sid) y cada petición verifica que siga activa.
model UserSession {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  /// Última petición autenticada o renovación. Más de SESSION_IDLE_TIMEOUT_MINUTES sin actividad cierra la sesión.
  lastActivityAt DateTime
  /// Vencimiento absoluto (REFRESH_TOKEN_TTL_DAYS), aunque haya actividad.
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  ipAddress      String?
  userAgent      String?
  refreshTokens  RefreshToken[]

  @@index([userId])
}

/// Refresh token rotativo. Solo se guarda el hash SHA-256; reutilizar uno ya rotado revoca toda la sesión.
model RefreshToken {
  id        String      @id @default(uuid())
  tokenHash String      @unique
  sessionId String
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  rotatedAt DateTime?

  @@index([sessionId])
}

/// Invitación a un workspace por enlace (RF-06). Solo se guarda el hash SHA-256 del token.
model Invitation {
  id          String           @id @default(uuid())
  email       String
  name        String
  role        Role
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDIENTE)
  expiresAt   DateTime
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Administrador que invitó. Queda en null si después se da de baja.
  invitedById String?
  invitedBy   User?            @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  revokedAt   DateTime?

  @@index([workspaceId, status])
  @@index([email])
}

/// Estrategia de enmascaramiento de un campo sensible (RF-20).
enum MaskingStrategy {
  EMAIL
  PHONE
  FULL
  HASH
}

/// Campo marcado como sensible (RF-20, issue #34). conexionId o entidad vacíos ("") = aplica a todas.
/// Se usa "" en lugar de NULL para que el índice único impida reglas duplicadas (en PostgreSQL NULL no se repite).
/// Los roles sin VIEW_UNMASKED_DATA nunca reciben su valor real en ningún endpoint.
model SensitiveField {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conexionId  String          @default("")
  entidad     String          @default("")
  campo       String
  estrategia  MaskingStrategy @default(FULL)
  creadoPor   String?
  createdAt   DateTime        @default(now())

  @@unique([workspaceId, conexionId, entidad, campo])
  @@index([workspaceId])
}

/// Visibilidad de una consulta guardada (issue #35). El LECTOR solo ve y ejecuta las PUBLICADA.
enum SavedQueryVisibility {
  PRIVADA
  PUBLICADA
}

enum ScheduledReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ScheduledReportStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum ScheduledReportFormat {
  EXCEL
  PDF
  JSON
  WORD
}

/// Estado de una ejecución de reporte (issue #39). RUNNING incluye los reintentos en curso.
enum ReportExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Origen de una ejecución: horario programado, "Ejecutar ahora" o POST /reports/trigger.
enum ReportExecutionTrigger {
  SCHEDULED
  MANUAL
  ON_DEMAND
}

/// Consulta guardada / vista unificada del Query Builder (UC4/UC7, issue #35).
/// `definicion` es el cuerpo de POST /engine/join sin la paginación (limit/offset), que se decide al ejecutar.
model SavedQuery {
  id          String               @id @default(uuid())
  workspaceId String
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  definicion  Json
  /// Versión vigente de la definición. Cada cambio de `definicion` la incrementa y guarda una copia en SavedQueryVersion.
  version     Int                  @default(1)
  visibilidad SavedQueryVisibility @default(PRIVADA)
  /// Autor de la consulta. Queda en null si se da de baja al usuario.
  autorId     String?
  autor       User?                @relation(fields: [autorId], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  versiones   SavedQueryVersion[]
  programaciones ScheduledReport[]

  @@unique([workspaceId, nombre])
  @@index([workspaceId, visibilidad])
}

/// Historial de definiciones de una consulta guardada (versionado simple, issue #35).
model SavedQueryVersion {
  id           String     @id @default(uuid())
  savedQueryId String
  savedQuery   SavedQuery @relation(fields: [savedQueryId], references: [id], onDelete: Cascade)
  version      Int
  definicion   Json
  autorId      String?
  autor        User?      @relation(fields: [autorId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@unique([savedQueryId, version])
}

/// Programación recurrente de un reporte basado en una consulta guardada (issue #38).
model ScheduledReport {
  id            String                   @id @default(uuid())
  workspaceId   String
  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  savedQueryId  String
  savedQuery    SavedQuery               @relation(fields: [savedQueryId], references: [id], onDelete: Restrict)
  createdById   String?
  createdBy     User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  nombre        String
  frecuencia    ScheduledReportFrequency
  hora          String
  diaSemana     Int?
  diaMes        Int?
  zonaHoraria   String
  formato       ScheduledReportFormat
  destinatarios String[]                 @default([])
  enviarCorreo  Boolean                  @default(true)
  estado        ScheduledReportStatus    @default(ACTIVE)
  lastRunAt     DateTime?
  lastError     String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @default(now()) @updatedAt
  executions    ReportExecution[]

  @@index([workspaceId, estado])
  @@index([savedQueryId])
}

/// Historial de cada ejecución de reporte (issue #39): programadas, manuales y bajo demanda.
/// Nunca guarda filas ni contenido del reporte; los errores son mensajes seguros y breves.
model ReportExecution {
  id                String                 @id @default(uuid())
  workspaceId       String
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// null en reportes bajo demanda (POST /reports/trigger).
  scheduledReportId String?
  scheduledReport   ScheduledReport?       @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)
  trigger           ReportExecutionTrigger
  status            ReportExecutionStatus  @default(RUNNING)
  /// Título del reporte en el momento de ejecutarse.
  titulo            String?
  /// excel, pdf, json o word.
  formato           String?
  /// Usuario con cuyo rol se generó el reporte. Sin FK: el historial sobrevive a la baja del usuario.
  actorUserId       String?
  scheduledFor      DateTime?
  idempotencyKey    String?                @unique
  startedAt         DateTime               @default(now())
  leaseExpiresAt    DateTime?
  finishedAt        DateTime?
  /// Milisegundos entre el inicio y el fin, incluidos los reintentos.
  durationMs        Int?
  /// Intentos realizados (1 = sin reintentos).
  attempts          Int                    @default(1)
  totalRows         Int?
  fileSizeBytes     Int?
  error             String?
  downloadUrl       String?
  expiresAt         DateTime?
  messageId         String?
  /// Cuándo se avisó al autor de que la ejecución falló.
  authorNotifiedAt  DateTime?

  @@index([workspaceId, startedAt])
  @@index([scheduledReportId, startedAt])
  @@index([status, leaseExpiresAt])
}

/// Uso diario de un workspace (issue #40): solicitudes autenticadas a la API y bytes extraídos de las fuentes
/// en joins, exportaciones y reportes. Se acumula en memoria y se vuelca con incrementos atómicos.
model WorkspaceUsageDaily {
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Día en UTC.
  dia             DateTime  @db.Date
  solicitudesApi  Int       @default(0)
  bytesProcesados BigInt    @default(0)

  @@id([workspaceId, dia])
}

/// Token de acceso personal para integraciones (BI, scripts) (issue #65).
/// Solo se guarda el hash SHA-256: el token en claro se muestra una única vez al crearlo o rotarlo.
model PersonalAccessToken {
  id          String    @id @default(uuid())
  nombre      String
  /// SHA-256 hexadecimal del token completo (pat_...).
  tokenHash   String    @unique
  /// Primeros caracteres del token, para reconocerlo en la lista sin revelarlo.
  prefijo     String
  /// Alcances concedidos (queries:read, results:read...). Nunca dan más que el rol del dueño.
  permisos    String[]
  expiresAt   DateTime
  lastUsedAt  DateTime?
  lastUsedIp  String?
  revokedAt   DateTime?
  /// Token al que sustituye cuando se crea por rotación.
  rotatedFromId String?
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
}

/// Libro de Excel (o CSV) subido al workspace: una fuente de datos sin servidor. Cada hoja se explora como una tabla
/// y se puede cruzar con las conexiones en el editor de consultas. Su id funciona como `conexionId` en el motor.
enum EstadoExcel {
  PROCESANDO
  LISTO
  ERROR
}

model ArchivoExcel {
  id            String      @id @default(uuid())
  nombre        String
  /// Nombre original del archivo subido (solo informativo).
  nombreArchivo String
  tamanoBytes   BigInt
  creadoPor     String
  /// La carga corre en segundo plano: PROCESANDO mientras se leen y guardan las filas.
  estado          EstadoExcel @default(LISTO)
  /// Avance de la carga (0 a 100) y registros guardados hasta ahora.
  progreso        Int         @default(100)
  filasProcesadas Int         @default(0)
  /// Motivo de la última carga fallida (si un reemplazo falla, los datos anteriores siguen disponibles).
  error           String?
  /// Observaciones de la última carga: encabezados ajustados, identificadores vacíos o repetidos.
  avisos          Json        @default("[]")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hojas         HojaExcel[]

  @@index([workspaceId])
}

/// Hoja de un libro de Excel ya normalizada: la primera fila son los nombres de columna y la primera columna es el
/// identificador de cada registro (`columnaId`).
model HojaExcel {
  id         String       @id @default(uuid())
  nombre     String
  posicion   Int
  /// Nombres de columna en el orden del archivo (string[]).
  columnas   Json
  columnaId  String
  totalFilas Int
  /// Tipo de cada columna en el orden de `columnas` (texto, numero o booleano).
  tipos      Json         @default("[]")
  /// Tabla de PostgreSQL con los registros (una columna c1..cN por columna del archivo y _fila como llave).
  tabla      String?
  /// Formato anterior: registros como JSON. Se migra a `tabla` al arrancar y queda en null.
  filas      Json?
  archivoId  String
  archivo    ArchivoExcel @relation(fields: [archivoId], references: [id], onDelete: Cascade)

  @@unique([archivoId, nombre])
}
