// Esquema de persistencia interna de DataNexus (Dossier Técnico, sección 4).
// Motor: PostgreSQL en todos los entornos (local vía docker-compose, staging y producción).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Matriz RBAC de 4 roles. Debe coincidir con USER_ROLES en src/auth/interfaces/user-role.ts.
enum Role {
  ADMIN
  OPERADOR
  LECTOR
  AUDITOR
}

/// Motores de bases de datos externas soportados. Debe coincidir con TIPOS_MOTOR en src/common/tipo-motor.ts.
enum TipoMotor {
  POSTGRESQL
  MYSQL
  SQLSERVER
  FIRESTORE
  MONGODB
}

/// Eventos de la bitácora. Debe coincidir con AUDIT_EVENT_TYPES en src/audit/audit.types.ts.
enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  USER_ROLE_CHANGED
  USER_INVITED
  CONNECTION_CREATED
  CONNECTION_UPDATED
  CONNECTION_DELETED
  REPORT_GENERATED_AND_SENT
  EXECUTE_JOIN
  EXPORT
  MODIFY_RECORD
  AUDIT_LOG_EXPORTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  LOGOUT
  SESSION_EXPIRED
  REFRESH_TOKEN_REUSED
  ACCOUNT_LOCKED
  WORKSPACE_UPDATED
  INVITATION_RESENT
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  USER_REMOVED
  BROWSE_DATA
}

/// Estado persistido de una invitación. La expiración se calcula con expiresAt (PENDIENTE vencida = EXPIRADA).
enum InvitationStatus {
  PENDIENTE
  ACEPTADA
  REVOCADA
}

/// Espacio de trabajo (tenant). Toda consulta de negocio se filtra por su id (RF-05).
model Workspace {
  id                 String       @id @default(uuid())
  nombreEmpresa      String
  /// URL https del logo que muestra el cliente web.
  logoUrl            String?
  /// Zona horaria IANA (p. ej. America/Managua) para fechas y reportes programados.
  zonaHoraria        String       @default("UTC")
  /// Dominios de correo admitidos al invitar miembros. Vacío = sin restricción adicional.
  dominiosPermitidos String[]     @default([])
  /// Campos sensibles por defecto del workspace; los consumirá el enmascaramiento configurable (RF-20).
  camposSensibles    String[]     @default([])
  fechaCreacion      DateTime     @default(now())
  fechaActualizacion DateTime     @default(now()) @updatedAt
  users              User[]
  conexiones         ConexionDB[]
  invitations        Invitation[]
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String
  password            String
  role                Role                 @default(LECTOR)
  /// Intentos de login fallidos consecutivos. Se reinicia al entrar o al bloquear la cuenta.
  failedLoginAttempts Int                  @default(0)
  /// Bloqueo temporal tras LOGIN_MAX_ATTEMPTS intentos fallidos (RF-01/RF-02).
  lockedUntil         DateTime?
  workspaceId         String
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]
  sessions            UserSession[]
  invitationsSent     Invitation[]

  @@index([workspaceId])
}

model ConexionDB {
  id                         String    @id @default(uuid())
  nombre                     String?
  tipoMotor                  TipoMotor
  host                       String
  dbName                     String
  /// Credenciales cifradas (AES-256). Versión 1: cadena de conexión libre (legado). Versión 2: JSON estructurado por motor (RF-08/RF-09).
  connectionStringEncriptada String
  credencialesVersion        Int       @default(1)
  /// Metadatos NO secretos de las credenciales (puerto, usuario, ssl, projectId...). Nunca contiene contraseñas ni claves.
  detalles                   Json?
  workspaceId                String
  workspace                  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Bitácora inmutable: un trigger de PostgreSQL y PrismaService bloquean UPDATE, DELETE y TRUNCATE.
model RegistroAuditoria {
  id          String         @id @default(uuid())
  eventType   AuditEventType
  outcome     String
  actorUserId String?
  actorEmail  String?
  workspaceId String?
  targetType  String?
  targetId    String?
  detailsJson String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
}

/// Token de un solo uso para recuperar la contraseña (RF-03). Solo se guarda el hash SHA-256 del token.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Sesión de usuario (RF-04). El access token JWT lleva su id (sid) y cada petición verifica que siga activa.
model UserSession {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  /// Última petición autenticada o renovación. Más de SESSION_IDLE_TIMEOUT_MINUTES sin actividad cierra la sesión.
  lastActivityAt DateTime
  /// Vencimiento absoluto (REFRESH_TOKEN_TTL_DAYS), aunque haya actividad.
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  ipAddress      String?
  userAgent      String?
  refreshTokens  RefreshToken[]

  @@index([userId])
}

/// Refresh token rotativo. Solo se guarda el hash SHA-256; reutilizar uno ya rotado revoca toda la sesión.
model RefreshToken {
  id        String      @id @default(uuid())
  tokenHash String      @unique
  sessionId String
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  rotatedAt DateTime?

  @@index([sessionId])
}

/// Invitación a un workspace por enlace (RF-06). Solo se guarda el hash SHA-256 del token.
model Invitation {
  id          String           @id @default(uuid())
  email       String
  name        String
  role        Role
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDIENTE)
  expiresAt   DateTime
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Administrador que invitó. Queda en null si después se da de baja.
  invitedById String?
  invitedBy   User?            @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  revokedAt   DateTime?

  @@index([workspaceId, status])
  @@index([email])
}
