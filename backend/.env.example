# ─── DataNexus backend ──────────────────────────────────────────────
# Copia este archivo a .env (`cp .env.example .env`). La app valida estas
# variables al arrancar y no inicia si falta alguna requerida.
# Los valores de ejemplo de secretos se rechazan con NODE_ENV=production.

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Requerido. PostgreSQL local: `docker compose up -d postgres` (ver docker-compose.yml).
DATABASE_URL="postgresql://datanexus:datanexus@localhost:5432/datanexus?schema=public"

# Requerido (mínimo 32 caracteres). Genera uno propio: `openssl rand -base64 48`
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-64-caracteres"
# Vida del access token. La sesión se mantiene con el refresh token (POST /auth/refresh).
JWT_EXPIRES_IN="15m"
# Cierre de sesión por inactividad (RF-04) y vida máxima de una sesión.
SESSION_IDLE_TIMEOUT_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# Requerido: 64 caracteres hex (32 bytes) para AES-256. Genera uno propio: `openssl rand -hex 32`
# ¡Si cambias esta clave, las conexiones guardadas ya no podrán descifrarse!
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Opcional: SMTP. Sin SMTP_HOST se usa un transporter simulado en memoria.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DataNexus <no-reply@datanexus.io>"

# Opcional: límites del motor de Cross-Joins.
DATA_ENGINE_MAX_SOURCE_ROWS=10000
DATA_ENGINE_MAX_JOIN_ROWS=100000
DATA_ENGINE_MAX_SOURCE_BYTES=33554432
DATA_ENGINE_MAX_JOIN_BYTES=67108864

# Opcional: seed de datos demo (`npm run db:seed`).
SEED_ADMIN_EMAIL=admin@datanexus.demo
SEED_PASSWORD="DataNexus2026!"

# Opcional: minutos de validez del enlace de recuperación de contraseña (5-1440, por defecto 30).
PASSWORD_RESET_TTL_MINUTES=30
