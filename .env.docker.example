# Solo para desarrollo local con Docker Compose.
# Opcional: `docker compose up` funciona sin .env con estos mismos valores de desarrollo.
# Para cambiarlos, copia este archivo como .env en la raíz del repositorio.
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Claves de desarrollo: genera valores propios antes de cualquier uso real.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-64-caracteres
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Fuentes de la demo (issue #49). Contraseñas solo de desarrollo; las usan los contenedores y el seed.
# DEMO_SQLSERVER_PASSWORD=DataNexus_Demo2026!
# DEMO_MYSQL_PASSWORD=datanexus_demo
# DEMO_MYSQL_ROOT_PASSWORD=datanexus_root
# DEMO_POSTGRES_PASSWORD=datanexus_demo

# Puertos publicados en tu máquina (cámbialos si ya están ocupados).
# FRONTEND_PORT=3000
# BACKEND_PORT=3001
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# DEMO_SQLSERVER_PORT=1433
# DEMO_MYSQL_PORT=3306
# DEMO_POSTGRES_PORT=5433
# DEMO_MONGO_PORT=27017
# DEMO_FIRESTORE_PORT=8080
