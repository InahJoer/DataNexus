# Copia a .env.production y reemplaza los valores marcados antes de usar Compose.
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://app.example.com
DATABASE_URL=postgresql://usuario:clave@host:5432/datanexus?schema=public
NEXT_PUBLIC_API_URL=https://api.example.com
# URL pública del backend; habilita Swagger UI (/api/docs) en producción.
API_PUBLIC_URL=https://api.example.com

# Genera cada clave una sola vez y conserva la misma en ejecuciones futuras.
#   openssl rand -base64 48
JWT_SECRET=REEMPLAZAR_POR_SECRETO_GENERADO
#   openssl rand -hex 32
# Cambiar esta clave impide descifrar credenciales de conexiones ya guardadas.
ENCRYPTION_KEY=REEMPLAZAR_POR_CLAVE_HEX_DE_64_CARACTERES

# Reportes: con almacenamiento local, producción exige la URL pública HTTPS del backend.
REPORT_STORAGE_PROVIDER=local
REPORTS_PUBLIC_BASE_URL=https://api.example.com

JWT_EXPIRES_IN=15m
SESSION_IDLE_TIMEOUT_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DataNexus <no-reply@datanexus.io>
SEED_ADMIN_EMAIL=
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=72
DATA_ENGINE_MAX_SOURCE_ROWS=10000
DATA_ENGINE_MAX_JOIN_ROWS=100000
DATA_ENGINE_MAX_SOURCE_BYTES=33554432
DATA_ENGINE_MAX_JOIN_BYTES=67108864
DATA_SOURCE_POOL_IDLE_MS=300000
DATA_SOURCE_POOL_MAX_ENTRIES=50
# Tiempo máximo (ms) de "Probar conexión" (RF-10). La petición puede pedir entre 1000 y 30000.
CONNECTION_TEST_TIMEOUT_MS=10000
